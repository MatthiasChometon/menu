# Security headers for the static site (Netlify reads this file verbatim).
# A prerendered Nuxt app needs no inline eval and loads nothing from a third
# party, so the policy can be strict without breaking anything.
/*
  # Nuxt inlines its hydration payload in a <script>, hence 'unsafe-inline' on
  # script-src; everything else is locked to this origin. When the API is
  # deployed, add ITS host to connect-src — and only once the name is really
  # yours, never a guessed one.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'; upgrade-insecure-requests
  # Six months, so a downgrade attack has no window to work in.
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  # Nothing here needs a camera, a microphone or a location.
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# The service worker must never be served stale: a pinned one would keep an old
# app, and an old app keeps an old policy.
/sw.js
  Cache-Control: no-cache

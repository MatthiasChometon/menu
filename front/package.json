{
  "name": "menu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Le Menu — recettes, apports et liste de courses de la semaine",
  "author": "Matthias Chometon <matthiaschometon787@gmail.com>",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "tsx infrastructure/images/scripts/localizeImages.ts && nuxt generate && tsx infrastructure/performance/scripts/pruneGeneratedCss.ts && tsx infrastructure/performance/scripts/inlineCriticalCss.ts",
    "check:generated": "tsx infrastructure/images/scripts/checkGenerated.ts && tsx infrastructure/performance/scripts/checkEntryChunk.ts && tsx infrastructure/performance/scripts/checkStylesheet.ts",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "check": "tsx domain/menu/scripts/check.ts",
    "order": "tsx domain/order/scripts/order.ts",
    "pantry": "tsx domain/order/scripts/pantry.ts",
    "photos": "tsx infrastructure/asset/scripts/generate.ts",
    "icons": "tsx domain/menu/scripts/brand/icons.ts",
    "og": "tsx domain/menu/scripts/brand/og.ts",
    "seed-images": "tsx infrastructure/asset/scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "pnpm generate && playwright test",
    "test:visual:update": "pnpm generate && playwright test --update-snapshots",
    "calibrate": "node perf-calibration.cjs --clear && pnpm dlx @lhci/cli@0.15.1 collect --config=lighthouserc.warmup.cjs && node perf-calibration.cjs .lighthouseci",
    "test:perf": "playwright test -c playwright.perf.config.ts",
    "bench": "vitest bench --run --outputJson bench/current.json && tsx bench/compare.ts",
    "bench:baseline": "vitest bench --run --outputJson bench/baseline.json",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nuxt/ui": "^4.13.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@sentry/vue": "^10.78.0",
    "graphql-request": "^7.4.0",
    "nuxt": "^4.7.0",
    "nuxt-graphql-client": "^0.2.46",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.117",
    "@iconify-json/simple-icons": "^1.2.92",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@napi-rs/canvas": "^1.0.8",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.61.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/vue": "^8.1.0",
    "@vite-pwa/nuxt": "^1.0.4",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "beasties": "^0.5.5",
    "eslint": "^10.7.0",
    "eslint-plugin-jsonc": "^3.3.0",
    "happy-dom": "^20.10.6",
    "postcss": "8.5.33",
    "prettier": "^3.9.5",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}

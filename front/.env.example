PORT=3777

# The front runs with sensible dev defaults, so a local checkout needs none of
# the values below — they are shown to make clear what a deploy overrides, and
# what each one defaults to.

# Where the browser reaches the API. Defaults to http://localhost:3779.
# NUXT_PUBLIC_API_BASE=http://localhost:3779

# GraphQL endpoint, server-side and browser-side. Both default to
# http://localhost:3779/graphql (they only differ under Docker).
# GQL_HOST=http://localhost:3779/graphql
# GQL_CLIENT_HOST=http://localhost:3779/graphql

# Where dish photos are served from. Defaults to the public production host, so
# images load in a local checkout with nothing to set.
# NUXT_PUBLIC_IMAGES_BASE=https://images.menu.mtxlab.xyz

# The site's own base URL, for canonical links and i18n alternates.
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3777

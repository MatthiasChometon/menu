{
  "name": "menu-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "vite build",
    "build:firefox": "vite build --mode firefox",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{background,carrefour,engine,menu,popup}/**/*.ts\"",
    "lint:fix": "eslint \"{background,carrefour,engine,menu,popup}/**/*.ts\" --fix",
    "format": "prettier --write \"{background,carrefour,engine,menu,popup}/**/*.ts\" \"*.mts\"",
    "format:check": "prettier --check \"{background,carrefour,engine,menu,popup}/**/*.ts\" \"*.mts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/chrome": "^0.1.28",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.1.14",
    "vitest": "^4.1.10"
  }
}

# Read by Docker Compose only — the apps get their own configuration from the
# compose files (and their secrets from back/.env).

# Host the browser uses to reach the stack. Leave it out for a plain local run;
# set it to your LAN IP (e.g. 192.168.1.20) to open the app from a phone, so the
# front calls the API on an address that resolves from outside this machine.
# Google sign-in only accepts localhost as a redirect target, so over the LAN
# use the email/password form instead.
PUBLIC_HOST=localhost

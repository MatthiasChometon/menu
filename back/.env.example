# Port of the API. 3777 is the front dev server and 3778 its visual-test preview.
PORT=3779

# Postgres. The compose file at the repo root exposes it on 5433 to avoid
# colliding with any local Postgres already listening on 5432.
DATABASE_URL=postgres://menu:menu@localhost:5433/menu

# The e2e suite never touches the database above: it provisions this one.
TEST_DATABASE_URL=postgres://menu:menu@localhost:5433/menu_test

# Signs the session cookie. In production the server refuses to boot on this
# value or on anything shorter than 32 characters — generate a real one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-secret-change-me

# Google sign-in. Create a Web application client in the Google Cloud console
# and register BACK_URL/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the browser reaches this API, used to build the OAuth redirect URI.
BACK_URL=http://localhost:3779
# Where to send the browser back once signed in.
FRONT_URL=http://localhost:3777

# Where crashes are reported. Empty means the API keeps them to its own log,
# which is the normal state of a local checkout — reporting is opt-in, not
# something a developer switches off.
SENTRY_DSN=

# --- Hardening (empty is only safe on a machine nobody else can reach) -------

# Who may hold an account, comma separated, or * to invite anyone. Empty is
# refused outright in production: "everyone may sign up" and "somebody forgot
# the guest list" look identical at runtime, so the open door has to be written.
# How many bug reports may be announced by email in one hour, everybody
# included. Unset means twenty. The per-account caps are defeated by opening
# more accounts, so this is the figure that actually bounds one inbox — and it
# depends on how many people use the site, which is why it is not a constant.
BUG_NOTICES_PER_HOUR=

ALLOWED_EMAILS=

# --- Sending mail ------------------------------------------------------------
# Where verification links go out from. Unset is fine in a checkout — the link
# is written to the log instead — and refused outright in production, where an
# account nobody can confirm is an account nobody can use.
#
# The host has to be the name the certificate was issued for, not the one the
# mailbox lives under: o2switch answers on mail.bouclier.o2switch.net, and
# pointing at mail.<your-domain> fails on a name mismatch that reads like a
# password problem. Send from a domain with SPF and DKIM or expect the spam box.
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Browsers allowed to send credentialed requests, comma separated. Defaults to
# the local front and its visual-test preview.
ALLOWED_ORIGINS=http://localhost:3777,http://localhost:3778

# The front generates its types from the versioned back/infrastructure/graphql/
# schema.gql, so nothing needs introspection. Leave it off: it hands the whole
# schema to anyone who asks.
GRAPHQL_INTROSPECTION=false

# Where the photographs live on disk. Served by the web server from its own
# subdomain, written here by the upload route. Absent, the route refuses rather
# than guessing a path and filling the wrong folder.
IMAGES_ROOT=

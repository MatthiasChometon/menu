# Port of the API. 3777 is the front dev server and 3778 its visual-test preview.
PORT=3779

# Postgres. The compose file at the repo root exposes it on 5433 to avoid
# colliding with any local Postgres already listening on 5432.
DATABASE_URL=postgres://menu:menu@localhost:5433/menu

# The e2e suite never touches the database above: it provisions this one.
TEST_DATABASE_URL=postgres://menu:menu@localhost:5433/menu_test

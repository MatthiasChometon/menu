# Port of the API. The front dev server uses 3777, so the back sits next to it.
PORT=3778

# Postgres. The compose file at the repo root exposes it on 5433 to avoid
# colliding with any local Postgres already listening on 5432.
DATABASE_URL=postgres://menu:menu@localhost:5433/menu_semaine

# The e2e suite never touches the database above: it provisions this one.
TEST_DATABASE_URL=postgres://menu:menu@localhost:5433/menu_semaine_test
